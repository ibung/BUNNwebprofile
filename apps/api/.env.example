# Salin ke apps/api/.env. Jangan di-commit. Nama variabel DB_* dan APP_KEY mengikuti
# konvensi AdonisJS; sesuaikan bila versi yang terpasang memakai nama lain.
NODE_ENV=development
HOST=localhost
PORT=3333
LOG_LEVEL=info

# Buat dengan: node ace generate:key
APP_KEY=

# false saat dev lokal (http), true di produksi
SESSION_SECURE=false

# Lokal dev (cocok dengan compose.dev.yml). Di server, nilai ini diisi docker-compose.yml.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=bunn
DB_PASSWORD=
DB_DATABASE=bunn_portfolio

PUBLIC_SITE_URL=http://localhost:3000
UPLOADS_DIR=./storage/uploads

# Garam untuk hash alamat IP pada pesan kontak. Acak dan panjang.
IP_HASH_SALT=

# Hanya dibaca saat db:seed untuk membuat admin pertama. Hapus ADMIN_PASSWORD setelah seed.
ADMIN_EMAIL=
ADMIN_PASSWORD=
